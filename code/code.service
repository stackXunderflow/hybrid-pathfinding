[Unit]
Description=Hybrid Pathfinding solver
After=network.target

[Service]
Type=simple
ExecStart=/opt/hybrid-pathfinding/code --serve --port 8080
Restart=on-failure
RestartSec=5
User=hybrid
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/tmp

[Install]
WantedBy=multi-user.target
