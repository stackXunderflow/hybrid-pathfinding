{
	"compilerOptions": {
		"composite": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"target": "ES2022",
		"lib": ["ES2022"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"allowSyntheticDefaultImports": true,
		"outDir": "./dist",
		"types": ["node", "vite/client"]
	},
	"include": [
		"electron.vite.config.ts",
		"src/main/**/*",
		"src/preload/**/*",
		"src/shared/**/*"
	]
}
